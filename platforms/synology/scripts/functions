#!/bin/sh

# 群晖安装和升级会重建 target，用户数据单独保存在 var/app

PKG_NAME="${SYNOPKG_PKGNAME:-scrcpynasfree}"
PKG_DEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG_NAME}/target}"
PKG_VAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG_NAME}/var}"
APP_DIR="${PKG_DEST}/app"
DATA_DIR="${PKG_VAR}/app"

PERSISTENT_FILES="config.json devices.json settings.json plugin.css license.json license.back.json adbkey.pem scrcpynas.log"

# 判断许可证是否为应用内置的首次体验默认许可证
is_default_license() {
    [ -f "$1" ] && grep -Eq '"email"[[:space:]]*:[[:space:]]*"local-default"' "$1"
}

# 移动存在的用户文件，许可证以外的文件保持原有覆盖语义
move_file_if_exists() {
    source="$1"
    target="$2"
    if [ ! -f "$source" ]; then
        return 0
    fi
    case "$(basename "$target")" in
        license.json|license.back.json)
            if [ -e "$target" ] && ! is_default_license "$target"; then
                return 0
            fi
            ;;
    esac
    mv -f "$source" "$target"
}

# 创建套件持久化数据目录
ensure_data_dir() {
    mkdir -p "$DATA_DIR" || return 1
    chmod 750 "$DATA_DIR" 2>/dev/null || true
    chown "${PKG_NAME}:system" "$DATA_DIR" 2>/dev/null || true
    return 0
}

# 迁移旧版本写入程序目录的数据
migrate_app_data() {
    ensure_data_dir || return 1
    for name in $PERSISTENT_FILES; do
        source="${APP_DIR}/${name}"
        target="${DATA_DIR}/${name}"
        if [ -f "$source" ]; then
            move_file_if_exists "$source" "$target" || return 1
        fi
    done
    return 0
}

# 启动前恢复持久化数据到程序目录
sync_data_to_app() {
    ensure_data_dir || return 1
    mkdir -p "$APP_DIR" || return 1
    for name in $PERSISTENT_FILES; do
        move_file_if_exists "${DATA_DIR}/${name}" "${APP_DIR}/${name}" || return 1
        if [ -e "${APP_DIR}/${name}" ]; then
            chmod 640 "${APP_DIR}/${name}" 2>/dev/null || true
            chown "${PKG_NAME}:system" "${APP_DIR}/${name}" 2>/dev/null || true
        fi
    done
    return 0
}

# 停止后保存程序目录中的用户数据
sync_data_from_app() {
    ensure_data_dir || return 1
    mkdir -p "$APP_DIR" || return 1
    for name in $PERSISTENT_FILES; do
        move_file_if_exists "${APP_DIR}/${name}" "${DATA_DIR}/${name}" || return 1
    done
    return 0
}

# 按卸载向导选择删除用户数据
remove_user_data() {
    case "$DATA_DIR" in
        ""|"/"|"/var"|"/var/packages"|"/var/packages/${PKG_NAME}")
            echo "ERROR: refusing to remove unsafe data path: ${DATA_DIR}" >&2
            return 1
            ;;
    esac
    if [ -d "$DATA_DIR" ]; then
        find "$DATA_DIR" -mindepth 1 -delete
        rmdir "$DATA_DIR" 2>/dev/null || true
    fi
    return 0
}
